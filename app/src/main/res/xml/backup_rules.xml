<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and lower.
   Customer data (portal IDs/passwords, mobiles, ledgers) and the accounts PIN must never
   leave the phone through Google backup or adb backup, so everything is excluded.
   Use the app's own "Backup" share feature for intentional backups.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
